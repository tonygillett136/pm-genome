---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeaderSearch from '../../components/leaders/LeaderSearch';
import leadersData from '../../data/leaders.json';
import archetypesData from '../../data/archetypes.json';

const leaders = (leadersData as any).leaders ?? [];
const archetypes = archetypesData.archetypes ?? [];

const leaderSummaries = leaders.map((l: any) => ({
  id: l.id,
  name: l.name,
  slug: l.slug,
  title: l.title,
  company: l.company,
  primaryArchetype: l.primaryArchetype,
  dimensions: l.dimensions,
}));

const archetypeSummaries = archetypes.map((a: any) => ({
  id: a.id,
  name: a.name,
}));
---

<BaseLayout title="Leaders" description="Browse 280+ product leaders profiled from Lenny's Podcast transcripts.">
  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-12">
      <h1 class="mb-4 text-4xl font-extrabold tracking-tight">Leader Directory</h1>
      <p class="text-lg text-text-muted">
        {leaders.length} product leaders profiled from Lenny's Podcast.
      </p>
    </div>

    <LeaderSearch
      client:load
      leaders={leaderSummaries}
      archetypes={archetypeSummaries}
    />
  </div>
</BaseLayout>
