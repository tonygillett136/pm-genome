---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DIMENSIONS } from '../../lib/constants';
import archetypesData from '../../data/archetypes.json';

const archetypes = archetypesData.archetypes ?? [];

const archetypesWithTopDims = archetypes.map((archetype: any) => {
  const dims = archetype.dimensions || {};
  const topDims = Object.entries(dims)
    .sort((a: any, b: any) => b[1] - a[1])
    .slice(0, 3)
    .map(([dimId, score]: any) => ({
      dimId,
      score: score as number,
      dim: DIMENSIONS.find((d) => d.id === dimId),
    }));
  return { ...archetype, topDims };
});
---

<BaseLayout title="Archetypes" description="The 7 product leadership archetypes discovered from analyzing 302 episodes of Lenny's Podcast.">
  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-12 text-center">
      <h1 class="mb-4 text-4xl font-extrabold tracking-tight">The 7 Archetypes</h1>
      <p class="text-lg text-text-muted">
        Distinct product leadership styles discovered by clustering 280+ leaders across 6 dimensions.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {archetypesWithTopDims.map((archetype: any) => (
        <a
          href={`/archetypes/${archetype.id}`}
          class="group rounded-xl border border-border bg-bg-card p-6 transition-colors hover:border-bg-hover hover:bg-bg-hover"
        >
          <h2 class="mb-1 text-xl font-bold group-hover:text-vision">{archetype.name}</h2>
          <p class="mb-4 text-sm text-text-muted">{archetype.tagline}</p>

          <div class="mb-4 space-y-2">
            {archetype.topDims.map((td: any) => (
              <div>
                <div class="mb-0.5 flex items-center justify-between text-xs text-text-muted">
                  <span>{td.dim?.shortName}</span>
                  <span>{Math.round(td.score * 100)}%</span>
                </div>
                <div class="h-1 overflow-hidden rounded-full bg-border">
                  <div
                    class="h-full rounded-full"
                    style={`width: ${td.score * 100}%; background-color: ${td.dim?.color}`}
                  />
                </div>
              </div>
            ))}
          </div>

          <p class="text-sm text-text-muted line-clamp-3">{archetype.description}</p>
        </a>
      ))}
    </div>

    <div class="mt-16 text-center">
      <a href="/quiz" class="rounded-xl bg-vision px-8 py-4 text-lg font-semibold text-white transition-opacity hover:opacity-90">
        Discover Your Archetype
      </a>
    </div>
  </div>
</BaseLayout>
